<div class="max-w-2xl mx-auto p-6">
  <%= link_to "← New search", root_path, class: "text-blue-600" %>

  <h1 class="text-3xl font-bold mt-2 mb-6"><%= @title %></h1>

  <%= turbo_frame_tag "awards", src: person_awards_path(title: @title) do %>
    <div class="grid grid-cols-2 gap-4">
      <% AwardClassifier::FAMILIES.each do |_key, label, _phrase| %>
        <div class="border rounded-xl p-4 text-center bg-gray-50">
          <div class="flex justify-center">
            <div class="w-9 h-9 rounded-full border-4 border-gray-200 border-t-gray-500 animate-spin"></div>
          </div>
          <div class="font-bold mt-2 text-gray-400"><%= label %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "nominations", src: person_nominations_path(title: @title) %>

  <p class="mt-8 text-xs text-gray-400">Based on Wikipedia.</p>
</div>
