<%= turbo_frame_tag "awards" do %>
  <style>
    @keyframes egot-flip {
      from { transform: rotateY(90deg); opacity: 0; }
      to   { transform: rotateY(0deg);  opacity: 1; }
    }
    .egot-reveal { animation: egot-flip 0.5s ease-out both; }
  </style>

  <div class="flex items-center gap-3 mb-4">
    <% if @thumbnail_url %>
      <%= image_tag @thumbnail_url, class: "w-12 h-12 rounded-full object-cover" %>
    <% end %>
    <p class="text-lg font-medium">
      <% if @status.egot? %>
        🏆 EGOT!
      <% else %>
        <%= @status.score %>/4 — missing: <%= @status.missing_labels.to_sentence %>
      <% end %>
    </p>
  </div>

  <div class="grid grid-cols-2 gap-4" style="perspective: 800px;">
    <% AwardClassifier::FAMILIES.each_with_index do |(key, label, _phrase), i| %>
      <div class="egot-reveal border rounded-xl p-4 text-center <%= @status.won?(key) ? 'bg-green-50 border-green-300' : 'bg-gray-50' %>"
           style="animation-delay: <%= i * 120 %>ms;">
        <div class="text-4xl"><%= @status.won?(key) ? "✅" : "❌" %></div>
        <div class="font-bold mt-1"><%= label %></div>
        <ul class="mt-2 text-xs text-gray-600 space-y-0.5">
          <% @status.wins(key).each do |win| %>
            <li><%= win %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% end %>
